# Required: shared secret the mobile client must send to connect.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_TOKEN=

# Port the bridge server listens on.
PORT=8787

# Directory Claude Code operates in (the project you want it to work on).
PROJECT_DIR=/path/to/your/project

# Permission mode for the Claude Code session.
#   default            - ask before sensitive tools (surfaced as approve/deny cards)
#   acceptEdits        - auto-approve file edits, still ask for the rest
#   bypassPermissions  - never ask (use only on a trusted, isolated machine)
#   plan               - planning only, no edits
PERMISSION_MODE=default

# Optional: force a specific API key instead of reusing the logged-in `claude` CLI account.
# Leave blank to reuse whatever `claude` is already authenticated with.
# ANTHROPIC_API_KEY=
