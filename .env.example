# Required: shared secret your mobile client uses to log in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_TOKEN=

# Port the bridge listens on (also the published host port via docker-compose)
PORT=8787

# Where Claude Code works. Inside Docker leave it as /work and use PROJECT_DIR_HOST
# below to choose the host directory that gets mounted there.
PROJECT_DIR=/work

# Host directory mounted at /work inside the container (Docker only). Set this to
# the project you want Claude to operate on. Defaults to ./workspace next to
# docker-compose.yml.
PROJECT_DIR_HOST=./workspace

# Permission mode for Claude's tool use:
#   default            - ask for sensitive tools (you approve from the phone)
#   acceptEdits        - auto-allow file edits, still ask for the rest
#   bypassPermissions  - never ask (only use on a trusted, isolated machine)
#   plan               - planning only, no edits
PERMISSION_MODE=default

# Pick ONE Claude auth strategy:
#
#   (A) Use an API key — simplest in Docker:
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
#   (B) Reuse a logged-in Claude CLI account — leave ANTHROPIC_API_KEY empty
#       and mount your ~/.claude into the container by adding to compose:
#         volumes:
#           - ~/.claude:/data/.claude
